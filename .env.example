# Roblox Game Controller Site - Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Roblox API Configuration
ROBLOX_API_KEY=your_roblox_api_key_here
ROBLOX_UNIVERSE_ID=your_universe_id_here
ROBLOX_PLACE_ID=your_place_id_here

# Database Configuration (if applicable)
DATABASE_URL=your_database_url_here

# Session Secret
SESSION_SECRET=your_random_secret_key_here

# Optional: Roblox OAuth (if using authentication)
ROBLOX_CLIENT_ID=your_client_id_here
ROBLOX_CLIENT_SECRET=your_client_secret_here
ROBLOX_CALLBACK_URL=http://localhost:3000/auth/callback
