# Systemd service file for Roblox DataStore Manager
# Place this file at: /etc/systemd/system/datastore-manager.service

[Unit]
Description=Roblox DataStore Manager
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/datastore-manager

# Environment variables
Environment=FLASK_ENV=production
Environment=DATABASE_URL=mysql+pymysql://sheetsdigita:Y2dBbLW7xrSn@localhost/sheetsdigita
Environment=SECRET_KEY=your-secret-key-change-this-to-random-string
Environment=ENCRYPTION_KEY=your-encryption-key-change-this

# Start command - using Gunicorn with gevent workers
ExecStart=/var/www/datastore-manager/venv/bin/gunicorn \
    --workers 4 \
    --worker-class gevent \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile /var/log/datastore-manager/access.log \
    --error-logfile /var/log/datastore-manager/error.log \
    --log-level info \
    wsgi:app

# Restart policy
Restart=always
RestartSec=10

# Security
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
